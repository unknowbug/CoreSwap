float normal_noise_0(int sIdx) {
    const float amps[9] = float[](1, 1, 2, 2, 2, 1, 1, 1, 1);
    // first sampler（拆分坐标在 splitCoord，CPU 预计算 int32 格点 + float 小数）
    float d = 0.0f;
    float f = float(0.50097847358121328);
    for (int i = 0; i < 9; i++) {
        int b = sIdx * SPLIT_TOTAL + 0 + i * 6;
        int ix = int(splitBuf.splitCoord[b + 0]); int iy = int(splitBuf.splitCoord[b + 1]); int iz = int(splitBuf.splitCoord[b + 2]);
        float gx = splitBuf.splitCoord[b + 3]; float gy = splitBuf.splitCoord[b + 4]; float gz = splitBuf.splitCoord[b + 5];
        float ns = pn_sample3_f32(0 + i, ix, iy, iz, gx, gy, gz);
        d += amps[i] * ns * f;
        f /= 2.0f;
    }
    // second sampler（拆分坐标偏移 + 6n）
    float d2 = 0.0f;
    f = float(0.50097847358121328);
    for (int i = 0; i < 9; i++) {
        int b = sIdx * SPLIT_TOTAL + 0 + 6 * 9 + i * 6;
        int ix = int(splitBuf.splitCoord[b + 0]); int iy = int(splitBuf.splitCoord[b + 1]); int iz = int(splitBuf.splitCoord[b + 2]);
        float gx = splitBuf.splitCoord[b + 3]; float gy = splitBuf.splitCoord[b + 4]; float gz = splitBuf.splitCoord[b + 5];
        float ns = pn_sample3_f32(0 + 9 + i, ix, iy, iz, gx, gy, gz);
        d2 += amps[i] * ns * f;
        f /= 2.0f;
    }
    return (d + d2) * float(1.4999999999999998);
}

