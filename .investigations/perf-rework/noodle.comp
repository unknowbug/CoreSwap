    float d011 = ((float((minY + (cy + 1) * 8)) >= -60.0f && float((minY + (cy + 1) * 8)) < 321.0f) ? normal_noise_137(sIdx) : 0.0f);
    float d111 = ((float((minY + (cy + 1) * 8)) >= -60.0f && float((minY + (cy + 1) * 8)) < 321.0f) ? normal_noise_138(sIdx) : 0.0f);
    float d00 = d000 + (d100 - d000) * fx; float d10 = d010 + (d110 - d010) * fx;
    float d01 = d001 + (d101 - d001) * fx; float d11 = d011 + (d111 - d011) * fx;
    float d0 = d00 + (d10 - d00) * fy; float d1 = d01 + (d11 - d01) * fy;
    return d0 + (d1 - d0) * fz;
}

float eval_b(int sIdx, int ix, int iy, int iz) {
    float x = float(ix), y = float(iy), z = float(iz);
    return df_overworld_caves_noodle(sIdx, ix, iy, iz);
}

