        else if (t == 16) r = clamp(valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA1_T[ci]]], CF0_T[ci], CF1_T[ci]);
        else if (t == 17) {
            float inp = valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA1_T[ci]]];
            r = (inp >= CF0_T[ci] && inp < CF1_T[ci]) ? valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA2_T[ci]]] : valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA3_T[ci]]];
        }
        else if (t == 22) {
            float v = valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA1_T[ci]]];
            float d = ws_scale(int(CF0_T[ci]), v);
            r = d * abs(normal_noise(NOISE_SLOT_BASE[CA2_T[ci]] + corner * NOISE_SLOT_STRIDE[CA2_T[ci]], sIdx));
        }
        else if (t == 20) r = valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA1_T[ci]]];
        else if (t == 21) r = valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA1_T[ci]]];
        else if (t == 6) r = valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA1_T[ci]]] + valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA2_T[ci]]];
        else if (t == 7) r = valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA1_T[ci]]] * valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA2_T[ci]]];
        else if (t == 8) r = min(valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA1_T[ci]]], valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA2_T[ci]]]);
        else if (t == 9) r = max(valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA1_T[ci]]], valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[CA2_T[ci]]]);
        valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[ci]] = r;
    }
    return valBuf[PER_SAMPLE * sIdx + SLOT_OF_T[rootPos]];
}


