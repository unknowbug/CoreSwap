// perlin.comp —— Perlin 噪声（单 octave，float 版）compute shader
// 验证：真实 Perlin 噪声的 GPU FP32 vs CPU double 精度差
// 对齐 vanilla 1.20.1 PerlinNoiseSampler.sample（double 语义），此处降为 float 观察差异。
#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// binding 0: 噪声参数（permutation 表 + origin）
layout(set = 0, binding = 0, std430) buffer NoiseParams {
    uint perm[256];          // permutation[256]，0-255
    float originX, originY, originZ;
} params;

// binding 1: 输入坐标 (x,y,z) 三元组，长度 = 3*N
layout(set = 0, binding = 1, std430) buffer InputBuf {
    float coords[];
} inputBuf;

// binding 2: 输出噪声值，长度 = N
layout(set = 0, binding = 2, std430) buffer OutputBuf {
    float noise[];
} outputBuf;

// SimplexNoiseSampler.GRADIENTS（16 梯度）
const vec3 GRADIENTS[16] = vec3[](
    vec3( 1,  1,  0), vec3(-1,  1,  0), vec3( 1, -1,  0), vec3(-1, -1,  0),
    vec3( 1,  0,  1), vec3(-1,  0,  1), vec3( 1,  0, -1), vec3(-1,  0, -1),
    vec3( 0,  1,  1), vec3( 0, -1,  1), vec3( 0,  1, -1), vec3( 0, -1, -1),
    vec3( 1,  1,  0), vec3( 0, -1,  1), vec3(-1,  1,  0), vec3( 0, -1, -1)
);

float perlinFade(float v) {
    return v * v * v * (v * (v * 6.0 - 15.0) + 10.0);
}

float lerpF(float d, float s, float e) {
    return s + d * (e - s);
}

int mapPerm(int v) {
    return int(params.perm[v & 255]);
}

float gradDot(int hash, vec3 p) {
    vec3 g = GRADIENTS[hash & 15];
    return g.x * p.x + g.y * p.y + g.z * p.z;
}

float sampleSection(int sx, int sy, int sz, float lx, float ly, float lz, float fadeY) {
    int i = mapPerm(sx);
    int j = mapPerm(sx + 1);
    int k = mapPerm(i + sy);
    int l = mapPerm(i + sy + 1);
    int m = mapPerm(j + sy);
    int n = mapPerm(j + sy + 1);
    float d = gradDot(mapPerm(k + sz),     vec3(lx,     ly,     lz));
    float e = gradDot(mapPerm(m + sz),     vec3(lx - 1.0, ly,     lz));
    float f = gradDot(mapPerm(l + sz),     vec3(lx,     ly - 1.0, lz));
    float g = gradDot(mapPerm(n + sz),     vec3(lx - 1.0, ly - 1.0, lz));
    float h = gradDot(mapPerm(k + sz + 1), vec3(lx,     ly,     lz - 1.0));
    float o = gradDot(mapPerm(m + sz + 1), vec3(lx - 1.0, ly,     lz - 1.0));
    float p = gradDot(mapPerm(l + sz + 1), vec3(lx,     ly - 1.0, lz - 1.0));
    float q = gradDot(mapPerm(n + sz + 1), vec3(lx - 1.0, ly - 1.0, lz - 1.0));
    float r = perlinFade(lx);
    float s = perlinFade(fadeY);
    float t = perlinFade(lz);
    // lerp3（对齐 vanilla MathHelper.lerp3 的顺序）
    float x0 = lerpF(r, d, e);
    float x1 = lerpF(r, f, g);
    float x2 = lerpF(r, h, o);
    float x3 = lerpF(r, p, q);
    float y0 = lerpF(s, x0, x1);
    float y1 = lerpF(s, x2, x3);
    return lerpF(t, y0, y1);
}

float sampleNoise(vec3 pos) {
    float d = pos.x + params.originX;
    float e = pos.y + params.originY;
    float f = pos.z + params.originZ;
    int i = int(floor(d));
    int j = int(floor(e));
    int k = int(floor(f));
    float g = d - float(i);
    float h = e - float(j);
    float l = f - float(k);
    return sampleSection(i, j, k, g, h, l, h);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= outputBuf.noise.length()) {
        return;
    }
    vec3 pos = vec3(inputBuf.coords[idx * 3 + 0],
                    inputBuf.coords[idx * 3 + 1],
                    inputBuf.coords[idx * 3 + 2]);
    outputBuf.noise[idx] = sampleNoise(pos);
}
